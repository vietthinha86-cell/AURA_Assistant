/logs/
/reports/
/projects_cache.json
/benchmark_audio/
/test_audio_vi.*
/OK

# .NET / C# Build Artifacts
src/**/bin/
src/**/obj/

# OS & Editor Artifacts
.DS_Store
Thumbs.db
*.log
*.tmp
