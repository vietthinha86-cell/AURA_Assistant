# ============================================================================
# AURA DESKTOP ASSISTANT - CẤU HÌNH HỆ THỐNG (.env)
# Lưu ý an toàn: Không chia sẻ file .env chứa API Key thật lên mạng.
# ============================================================================

# --- MODULE E: BỘ NÃO AI (GEMINI API, GROQ FREE, OPENROUTER FREE & ANTHROPIC CLAUDE) ---
# DEFAULT_PROVIDER: auto (khuyên dùng: tự phân luồng + failover giữa các AI đã có key) | gemini | groq | openrouter | claude
DEFAULT_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
MAX_CONVERSATION_HISTORY=16
YOUTUBE_API_KEY= # (Tuỳ chọn: YouTube Data API v3 key để tăng tốc tìm video trực tiếp)

# --- MODULE D: GIỌNG NÓI RA (TTS) ---
# TTS_VOICE_VI: gemini:Leda (nữ trẻ AI tự nhiên) | gemini:Aoede (ấm áp) | gemini:Zephyr (tươi sáng) | gemini:Sulafat (ngọt ngào) | gemini:Kore (rõ ràng) | vi-VN-HoaiMyNeural (Edge nhanh)
TTS_PROVIDER=auto
TTS_GEMINI_MODEL=gemini-3.8-flash-lite-tts
TTS_VOICE_VI=gemini:Leda
TTS_VOICE_EN=en-US-AriaNeural
TTS_RATE=+10%
TTS_PITCH=+0Hz

# --- MODULE C: GIỌNG NÓI VÀO (STT) ---
# STT_PROVIDER: auto (ưu tiên Groq whisper-large-v3-turbo siêu nhanh 0MB RAM -> Gemini -> local faster-whisper) | groq | gemini | local
STT_PROVIDER=auto
GROQ_STT_MODEL=whisper-large-v3-turbo
STT_MODEL=small
STT_COMPUTE_TYPE=int8
STT_DEVICE=cpu
STT_IDLE_UNLOAD_SECONDS=300
WAKE_WORD_ENABLED=false
WAKE_WORD_PHRASE=Aura ơi

# --- MODULE B: HIỂN THỊ AVATAR VRM & RÀNG BUỘC HIỆU NĂNG ---
VRM_MODEL_PATH=/assets/models/aura.vrm
AVATAR_FPS_LIMIT=30
AVATAR_LITE_FPS_LIMIT=15
AVATAR_MAX_TEXTURE_SIZE=1024
RAM_LITE_MODE_THRESHOLD_PERCENT=90
AURA_MAX_RAM_MB=2500

# --- MODULE A: GIAO DIỆN DESKTOP ---
DEFAULT_WINDOW_MODE=docked
ALWAYS_ON_TOP=true
EMERGENCY_HOTKEY=Ctrl+Alt+Esc
